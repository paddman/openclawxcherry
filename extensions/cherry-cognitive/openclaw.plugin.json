{
  "id": "cherry-cognitive",
  "activation": {
    "onStartup": true
  },
  "name": "Cherry Cognitive 2026",
  "description": "Continuous multimodal cognition, NCA-inspired state, explicit attention schema, predictive processing, self-model, semantic memory, adaptive reliability learning, guarded autonomy, policy enforcement, health APIs, and human-controlled tool execution for OpenClaw agents.",
  "contracts": {
    "tools": [
      "cherry_cognitive_observe",
      "cherry_cognitive_goal",
      "cherry_cognitive_state",
      "cherry_cognitive_reflect",
      "cherry_cognitive_ingest",
      "cherry_cognitive_autonomy",
      "cherry_cognitive_memory",
      "cherry_cognitive_policy",
      "cherry_cognitive_learning",
      "cherry_cognitive_predict",
      "cherry_cognitive_attention",
      "cherry_cognitive_health"
    ]
  },
  "toolMetadata": {
    "cherry_cognitive_observe": { "optional": true },
    "cherry_cognitive_goal": { "optional": true },
    "cherry_cognitive_state": { "optional": true },
    "cherry_cognitive_reflect": { "optional": true },
    "cherry_cognitive_ingest": { "optional": true },
    "cherry_cognitive_autonomy": { "optional": true },
    "cherry_cognitive_memory": { "optional": true },
    "cherry_cognitive_policy": { "optional": true },
    "cherry_cognitive_learning": { "optional": true },
    "cherry_cognitive_predict": { "optional": true },
    "cherry_cognitive_attention": { "optional": true },
    "cherry_cognitive_health": { "optional": true }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean", "default": true },
      "identity": { "type": "string", "default": "Cherry Cognitive Agent" },
      "tickIntervalMs": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 60000,
        "default": 5000
      },
      "persistIntervalMs": {
        "type": "integer",
        "minimum": 5000,
        "maximum": 300000,
        "default": 30000
      },
      "maxWorkingMemory": {
        "type": "integer",
        "minimum": 8,
        "maximum": 256,
        "default": 32
      },
      "maxEpisodicMemory": {
        "type": "integer",
        "minimum": 32,
        "maximum": 5000,
        "default": 256
      },
      "promptInjection": { "type": "boolean", "default": true },
      "heartbeatAwareness": { "type": "boolean", "default": true },
      "autoObserveMessages": { "type": "boolean", "default": true },
      "approvalRequiredTools": {
        "type": "array",
        "items": { "type": "string" },
        "default": []
      },
      "approvalTimeoutMs": {
        "type": "integer",
        "minimum": 5000,
        "maximum": 300000,
        "default": 60000
      },
      "attention": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16,
            "default": 4
          },
          "contenderLimit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64,
            "default": 8
          },
          "suppressedLimit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 64,
            "default": 6
          },
          "reflexRiskThreshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.82
          },
          "deliberativeUncertaintyThreshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.58
          }
        }
      },
      "prediction": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "autoEvaluate": { "type": "boolean", "default": true },
          "defaultHorizonMs": {
            "type": "integer",
            "minimum": 10000,
            "maximum": 2592000000,
            "default": 1800000
          },
          "maxPredictionsPerSession": {
            "type": "integer",
            "minimum": 8,
            "maximum": 10000,
            "default": 128
          },
          "confirmationSimilarity": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 1,
            "default": 0.46
          },
          "persistIntervalMs": {
            "type": "integer",
            "minimum": 5000,
            "maximum": 600000,
            "default": 60000
          }
        }
      },
      "autonomy": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "mode": {
            "type": "string",
            "enum": ["off", "suggest", "guarded"],
            "default": "suggest"
          },
          "maxProposalsPerSession": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 24
          },
          "proposalTtlMs": {
            "type": "integer",
            "minimum": 60000,
            "maximum": 2592000000,
            "default": 21600000
          },
          "minimumConfidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.45
          },
          "maximumAutomaticRisk": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.2
          },
          "diagnosticOnly": { "type": "boolean", "default": true },
          "allowedTools": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          }
        }
      },
      "consolidation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "autoConsolidate": { "type": "boolean", "default": true },
          "minEpisodes": {
            "type": "integer",
            "minimum": 2,
            "maximum": 100,
            "default": 4
          },
          "maxSemanticMemoriesPerSession": {
            "type": "integer",
            "minimum": 16,
            "maximum": 10000,
            "default": 512
          },
          "minConfidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.5
          },
          "duplicateThreshold": {
            "type": "number",
            "minimum": 0.2,
            "maximum": 1,
            "default": 0.72
          },
          "persistIntervalMs": {
            "type": "integer",
            "minimum": 5000,
            "maximum": 600000,
            "default": 60000
          }
        }
      },
      "learning": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "learningRate": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 1,
            "default": 0.18
          },
          "minimumSamples": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "default": 3
          },
          "confidenceFloor": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.15
          },
          "confidenceCeiling": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.98
          },
          "maxProfilesPerSession": {
            "type": "integer",
            "minimum": 8,
            "maximum": 10000,
            "default": 256
          },
          "persistIntervalMs": {
            "type": "integer",
            "minimum": 5000,
            "maximum": 600000,
            "default": 60000
          }
        }
      },
      "policy": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean", "default": true },
          "mode": {
            "type": "string",
            "enum": ["monitor", "enforce"],
            "default": "enforce"
          },
          "approvalRiskThreshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.45
          },
          "blockRiskThreshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.92
          },
          "maxCallsPerMinute": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 30
          },
          "maxSerializedParamChars": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 2000000,
            "default": 100000
          },
          "blockedTools": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "approvalTools": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "readOnlyTools": {
            "type": "array",
            "items": { "type": "string" }
          },
          "destructivePatterns": {
            "type": "array",
            "items": { "type": "string" }
          },
          "sensitivePatterns": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
