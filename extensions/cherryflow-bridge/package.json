{
  "name": "@openclaw/cherryflow-bridge",
  "version": "2026.6.11",
  "description": "Authenticated CherryFlow HTTP bridge for OpenClaw agent runs.",
  "repository": {
    "type": "git",
    "url": "https://github.com/paddman/openclawxcherry"
  },
  "type": "module",
  "devDependencies": {
    "@openclaw/plugin-sdk": "workspace:*"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "defaultChoice": "local",
      "minHostVersion": ">=2026.6.11"
    },
    "compat": {
      "pluginApi": ">=2026.6.11"
    },
    "build": {
      "openclawVersion": "2026.6.11"
    },
    "release": {
      "publishToClawHub": false,
      "publishToNpm": false
    }
  }
}
