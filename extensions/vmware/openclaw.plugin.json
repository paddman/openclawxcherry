{
  "id": "vmware",
  "activation": {
    "onStartup": true
  },
  "name": "VMware vSphere",
  "description": "vCenter and direct ESXi inventory, status, task visibility, and approval-gated VM power operations across vSphere 6.x through 9.x.",
  "contracts": {
    "tools": [
      "vmware_connection_test",
      "vmware_virtual_machines",
      "vmware_vm_status",
      "vmware_vm_power",
      "vmware_recent_tasks"
    ]
  },
  "toolMetadata": {
    "vmware_connection_test": { "optional": true },
    "vmware_virtual_machines": { "optional": true },
    "vmware_vm_status": { "optional": true },
    "vmware_vm_power": { "optional": true },
    "vmware_recent_tasks": { "optional": true }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": { "type": "string" },
      "username": { "type": "string" },
      "password": { "type": "string" },
      "govcPath": { "type": "string", "default": "govc" },
      "verifyTls": { "type": "boolean", "default": true },
      "caFile": { "type": "string" },
      "datacenter": { "type": "string" },
      "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000, "default": 30000 },
      "allowMutations": { "type": "boolean", "default": false },
      "allowedVmPaths": {
        "type": "array",
        "items": { "type": "string" },
        "default": []
      },
      "maxResults": { "type": "integer", "minimum": 1, "maximum": 2000, "default": 200 }
    }
  }
}
