#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.error
import urllib.request
from typing import Any

DEFAULT_URL = "http://127.0.0.1:8787"


def request_json(method: str, path: str, payload: dict[str, Any] | None = None) -> dict[str, Any]:
    base_url = os.getenv("C_LEVEL_API_URL", DEFAULT_URL).rstrip("/")
    token = os.getenv("C_LEVEL_API_TOKEN", "").strip()
    data = json.dumps(payload, ensure_ascii=False).encode("utf-8") if payload is not None else None
    headers = {"Content-Type": "application/json", "Accept": "application/json"}
    if token:
        headers["Authorization"] = f"Bearer {token}"

    req = urllib.request.Request(
        f"{base_url}{path}",
        data=data,
        headers=headers,
        method=method,
    )
    try:
        with urllib.request.urlopen(req, timeout=360) as response:
            return json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        raise RuntimeError(f"C-Level API returned HTTP {exc.code}: {body}") from exc
    except urllib.error.URLError as exc:
        raise RuntimeError(
            f"Cannot reach C-Level API at {base_url}. Check cherry-c-level.service: {exc.reason}"
        ) from exc


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="cherry-org",
        description="OpenClaw bridge for Cherry Agent, Rabbit Boss, and the C-Level organization.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    health = sub.add_parser("health", help="Check the local C-Level API")
    health.add_argument("--json", action="store_true")

    route = sub.add_parser("route", help="Show which organization agents own a question")
    route.add_argument("question", nargs="+", help="Question or work request")
    route.add_argument("--json", action="store_true")

    meeting = sub.add_parser("meeting", help="Run an organization meeting and return one memo")
    meeting.add_argument("question", nargs="+", help="Decision or work request")
    meeting.add_argument("--agents", help="Comma-separated agent IDs to force")
    meeting.add_argument("--requester", default="openclaw")
    meeting.add_argument("--session-id")
    meeting.add_argument("--dry-run", action="store_true")
    meeting.add_argument("--json", action="store_true")

    return parser.parse_args()


def main() -> int:
    args = parse_args()
    try:
        if args.command == "health":
            result = request_json("GET", "/health")
            if args.json:
                print(json.dumps(result, ensure_ascii=False, indent=2))
            else:
                print(
                    f"{result.get('status', 'unknown')} | agents={result.get('agents')} | "
                    f"reasoning={result.get('reasoning_model')} | fast={result.get('fast_model')}"
                )
            return 0

        question = " ".join(args.question).strip()
        if not question:
            raise ValueError("Question must not be empty")

        if args.command == "route":
            result = request_json("POST", "/v1/route", {"question": question})
            if args.json:
                print(json.dumps(result, ensure_ascii=False, indent=2))
            else:
                print(", ".join(result.get("selected_agents", [])))
            return 0

        agents = None
        if args.agents:
            agents = [item.strip() for item in args.agents.split(",") if item.strip()]

        result = request_json(
            "POST",
            "/v1/meeting",
            {
                "question": question,
                "agents": agents,
                "requester": args.requester,
                "session_id": args.session_id,
                "dry_run": args.dry_run,
            },
        )
        if args.json or args.dry_run:
            print(json.dumps(result, ensure_ascii=False, indent=2))
        else:
            print(result.get("memo", ""))
        return 0
    except (RuntimeError, ValueError, json.JSONDecodeError) as exc:
        print(f"cherry-org error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
